<Window x:Class="Lengko.Alert.Demo.Wpf.CSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lengko.Alert.Wpf — C# Demo"
        Height="760" Width="980" MinHeight="600" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Width" Value="430" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="8,0,0,16">
            <TextBlock Text="Lengko.Alert Demo (C# WPF)" FontSize="22" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Zero external dependencies. Pure WPF hardware-accelerated vector alerts, toasts, and prompts."
                       FontSize="13.5" Foreground="#64748B" Margin="0,3,0,0" />
        </StackPanel>

        <!-- Cards ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel Orientation="Horizontal">

                <!-- Card 1: Basic Modal Alerts -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="1. Basic Modal Alerts" FontWeight="Bold" FontSize="15" Foreground="#1E293B" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button Content="Success Alert" Style="{StaticResource ActionButton}" Background="#22C55E" Click="BtnSuccess_Click" />
                            <Button Content="Error Alert" Style="{StaticResource ActionButton}" Background="#EF4444" Click="BtnError_Click" />
                            <Button Content="Warning Alert" Style="{StaticResource ActionButton}" Background="#F59E0B" Click="BtnWarning_Click" />
                            <Button Content="Info Alert" Style="{StaticResource ActionButton}" Background="#3B82F6" Click="BtnInfo_Click" />
                            <Button Content="Question Alert" Style="{StaticResource ActionButton}" Background="#8B5CF6" Click="BtnQuestion_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Card 2: Confirm & Prompt -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="2. Confirm &amp; Prompt" FontWeight="Bold" FontSize="15" Foreground="#1E293B" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button Content="Confirm (Sync)" Style="{StaticResource ActionButton}" Background="#4F46E5" Click="BtnConfirmSync_Click" />
                            <Button Content="Confirm (Async)" Style="{StaticResource ActionButton}" Background="#4F46E5" Click="BtnConfirmAsync_Click" />
                            <Button Content="Prompt Text" Style="{StaticResource ActionButton}" Background="#0284C7" Click="BtnPromptSync_Click" />
                            <Button Content="Prompt (Async)" Style="{StaticResource ActionButton}" Background="#0284C7" Click="BtnPromptAsync_Click" />
                            <Button Content="Prompt + Validator" Style="{StaticResource ActionButton}" Background="#0D9488" Click="BtnPromptValidator_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Card 3: Corner Toasts -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="3. Corner Toasts (Non-blocking)" FontWeight="Bold" FontSize="15" Foreground="#1E293B" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button Content="Toast Success (Top-End)" Style="{StaticResource ActionButton}" Background="#10B981" Click="BtnToastSuccess_Click" />
                            <Button Content="Toast Warning (Top-Start)" Style="{StaticResource ActionButton}" Background="#F59E0B" Click="BtnToastWarning_Click" />
                            <Button Content="Toast Error (Bottom-End)" Style="{StaticResource ActionButton}" Background="#EF4444" Click="BtnToastError_Click" />
                            <Button Content="Toast Info (Bottom-Center)" Style="{StaticResource ActionButton}" Background="#3B82F6" Click="BtnToastInfo_Click" />
                            <Button Content="Custom 5s Toast" Style="{StaticResource ActionButton}" Background="#64748B" Click="BtnToastCustom_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Card 4: Advanced & Custom Options -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="4. Advanced &amp; Custom Options" FontWeight="Bold" FontSize="15" Foreground="#1E293B" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button Content="Dark Theme Modal" Style="{StaticResource ActionButton}" Background="#1E293B" Click="BtnDarkTheme_Click" />
                            <Button Content="Non-Modal Floating Alert" Style="{StaticResource ActionButton}" Background="#0284C7" Click="BtnNonModal_Click" />
                            <Button Content="Oval / Pill Buttons" Style="{StaticResource ActionButton}" Background="#EC4899" Click="BtnPillButtons_Click" />
                            <Button Content="Backdrop Shake Demo" Style="{StaticResource ActionButton}" Background="#D97706" Click="BtnBackdropShake_Click" />
                            <Button Content="Radio / Select Inputs" Style="{StaticResource ActionButton}" Background="#7C3AED" Click="BtnRadioSelect_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </ScrollViewer>

        <!-- Bottom Responsiveness Test Bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,10,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnCounter" Grid.Column="0" Content="Test UI Responsiveness (Click Count: 0)" 
                        Style="{StaticResource ActionButton}" Background="#0284C7" Margin="0,0,14,0" Click="BtnCounter_Click" />
                <TextBox x:Name="TxtInteractive" Grid.Column="1" VerticalAlignment="Center" Padding="8,6" 
                         Text="Type here freely while toast or non-modal alert is floating..." 
                         Foreground="#475569" Background="#F1F5F9" BorderBrush="#CBD5E1" />
            </Grid>
        </Border>
    </Grid>
</Window>
